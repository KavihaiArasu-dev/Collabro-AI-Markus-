# Markus AI Environment Configuration
# Copy this file to .env and fill in your values

# ── OmniRoute AI Gateway ──
OMNIROUTE_BASE_URL=http://localhost:20128/v1
OMNIROUTE_API_KEY=YOUR_OMNIROUTE_KEY

# ── Application ──
MARKUS_HOST=0.0.0.0
MARKUS_PORT=8000
MARKUS_ENV=development
MARKUS_DEBUG=true
MARKUS_SECRET_KEY=change-this-to-a-random-secret-key

# ── Database ──
DATABASE_URL=mysql+pymysql://username:password@localhost:3306/markus
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USERNAME=root
MYSQL_PASSWORD=your_password
MYSQL_DBNAME=markus

# ── Redis (optional — falls back to in-memory) ──
REDIS_URL=redis://localhost:6379/0

# ── RAG / Embeddings ──
EMBEDDING_MODEL=all-MiniLM-L6-v2
VECTOR_STORE_PATH=./data/vector_store
DOCUMENTS_PATH=./data/documents

# ── Memory ──
MEMORY_DB_PATH=./data/memory.db

# ── Logging ──
LOG_LEVEL=INFO
LOG_FILE=./logs/markus.log
